<UserControl x:Class="ControllerWheel.CustomizeEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ControllerWheel">
  <Grid>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <!-- Visual selectors only — no explanatory text (tooltips carry the detail). -->
    <Grid Margin="16,12,16,16">
      <Grid.ColumnDefinitions>
        <!-- Left = the 300px tile column (content-sized: Material/Sound/Button Icons). Right holds Slice
             Thickness (270px grid), the Triggers builder, and the Accessibility checkboxes, so it needs
             the same room. -->
        <ColumnDefinition Width="Auto" MinWidth="308"/>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="*" MinWidth="308"/>
      </Grid.ColumnDefinitions>

      <!-- Every section is a peer top-level heading — no wrapper card. -->

      <!-- ── Left column ──────────────────────────────────────────── -->
      <StackPanel Grid.Column="0">

        <TextBlock Margin="0,0,0,6">
          <Run Text="{loc:T Material}" FontWeight="Bold" FontSize="15.5" Foreground="{StaticResource HeadingInk}"/>
        </TextBlock>
        <!-- Two labelled, hairline-outlined groups mirroring the onboarding Look step exactly, tile size
             aside: Simple = the two flat materials stacked in one narrow column, Deluxe = the other six in
             a 3×2 block. The 1*/3* split keeps every swatch about the same width across both groups, as it
             does there. The eight tiles are built in one ordered pass (BuildTiles) which routes each token
             to its group, so the two surfaces cannot drift on order or on which tiles count as a top row
             for the label-shadow dimming. -->
        <Grid HorizontalAlignment="Left" Width="300">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="3*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8" Padding="4,2,4,4">
            <StackPanel>
              <TextBlock Text="{loc:T Simple}" FontSize="12" FontWeight="SemiBold" Foreground="#88000000"
                         HorizontalAlignment="Center" Margin="0,2,0,2"/>
              <UniformGrid x:Name="SliceMaterialTiles" Columns="1"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8" Padding="4,2,4,4">
            <StackPanel>
              <TextBlock Text="{loc:T Deluxe}" FontSize="12" FontWeight="SemiBold" Foreground="#88000000"
                         HorizontalAlignment="Center" Margin="0,2,0,2"/>
              <UniformGrid x:Name="SliceMaterialTilesDeluxe" Columns="3"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Drop-in theme packages (docs/PACKAGES.md): a third group, visible only when at least one
             consented custom theme is registered (BuildTiles collapses it otherwise). Deliberately absent
             from onboarding — custom themes are a post-setup power feature. -->
        <Border x:Name="CustomMaterialGroup" BorderBrush="#33000000" BorderThickness="1" CornerRadius="8"
                Padding="4,2,4,4" Margin="0,8,0,0" HorizontalAlignment="Left" Width="300"
                Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="{loc:T Custom}" FontSize="12" FontWeight="SemiBold" Foreground="#88000000"
                       HorizontalAlignment="Center" Margin="0,2,0,2"/>
            <UniformGrid x:Name="SliceMaterialTilesCustom" Columns="3"/>
          </StackPanel>
        </Border>

        <!-- "Game grid material" tiles are temporarily absent: the Game Grid always follows the Material
             selection above. Restore the tiles + the ApplyTo/Load plumbing to re-enable. -->

        <!-- Directly under Material because the two are coupled: the default "Themed" tile follows the
             material's own sound set, and picking a material snaps the choice back to it (ApplySound).
             Width matches the tile grids around it. -->
        <TextBlock Margin="0,18,0,6">
          <Run Text="{loc:T Sound Effects}" FontWeight="Bold" FontSize="15.5" Foreground="{StaticResource HeadingInk}"/>
        </TextBlock>
        <UniformGrid x:Name="SoundFxTiles" Columns="4" HorizontalAlignment="Left" Width="300"/>

        <!-- There is no "Max Slices per Wheel" picker: the cap is always 12 (SystemConfig.MaxSlicesPerWheel),
             and SliceThicknessRule keeps Thick legible automatically from the live slice count. -->

        <!-- Width 300 (100px/tile, 3-across) so this grid matches the 4-across 300px grids above
             (75px/tile) at the same overall column width. -->
        <TextBlock Margin="0,18,0,6">
          <Run Text="{loc:T Button Icons}" FontWeight="Bold" FontSize="15.5" Foreground="{StaticResource HeadingInk}"/>
        </TextBlock>
        <UniformGrid x:Name="ButtonGlyphsTiles" Columns="3" HorizontalAlignment="Left" Width="300"/>

      </StackPanel>

      <!-- ── Right column ─────────────────────────────────────────── -->
      <StackPanel Grid.Column="2">

        <!-- Width 270 (90px/tile, 3-across) to match the Triggers builder and Accessibility section below. -->
        <TextBlock Margin="0,0,0,6">
          <Run Text="{loc:T Slice Thickness}" FontWeight="Bold" FontSize="15.5" Foreground="{StaticResource HeadingInk}"/>
        </TextBlock>
        <!-- Past the Thick limit the Thick tile is simply Collapsed (UpdateThicknessForSliceCount) — the
             explanation lives in the "customize" Help topic's Slice Thickness bullet, not on this screen.
             Don't put an in-place message in the tile's slot: it reads as a pseudo-button. -->
        <UniformGrid x:Name="ThicknessTiles" Columns="3" HorizontalAlignment="Left" Width="270"/>

        <!-- ── D-Pad 🡄 🡆 and "Show labels on" live here, under Slice Thickness: both are look-and-feel
             choices about the wheel, which is what this tab is (Advanced is for the machine). ⚠ This tab
             owns SystemConfig.DpadHorizontalMode and SystemConfig.ShowSliceLabels — SystemEditorControl
             must not write either, since its ApplyTo runs last over this one's `with`. ──────────────── -->
        <TextBlock Margin="0,22,0,6">
          <Run x:Name="DpadHeadingRun" Text="{loc:T D-Pad 🡄 🡆}" FontFamily="Segoe UI, Segoe UI Symbol" FontWeight="Bold" FontSize="15.5" Foreground="{StaticResource HeadingInk}"/><Run Text="  "/><InlineUIContainer BaselineAlignment="Center"><Button Style="{DynamicResource HelpChip}" Click="HelpVolumeMixer_Click" Width="15" Height="15" FontSize="10" ToolTip="{loc:T D-pad controls help}" AutomationProperties.Name="{loc:T D-pad help}"/></InlineUIContainer>
        </TextBlock>

        <!-- Width 143: "Cycles Desktops" sits tight against the drop arrow at anything narrower. -->
        <ComboBox x:Name="DpadModeBox" Margin="0,2,0,6"
                  AutomationProperties.Name="{loc:T D-pad behaviour}"
                  SelectionChanged="DpadModeBox_SelectionChanged">
          <ComboBoxItem Tag="switcher" Content="{loc:T Cycles Windows}"/>
          <ComboBoxItem Tag="desktop"  Content="{loc:T Cycles Desktops}"/>
          <ComboBoxItem Tag="song"     Content="{loc:T Skips Songs}"/>
          <ComboBoxItem Tag="mic"      Content="{loc:T Mic Volume}"/>
          <!-- "Audio Mixer" (Tag="mixer") is deliberately absent: it doesn't work on device. The plumbing
               stays intact — App's DpadChanged keeps its "mixer" branch (and it's the unknown-token
               fallback), AppVolumeMixer / MixPairText / the mix-balance bar are all live — so re-adding
               this one ComboBoxItem is the whole fix if the behaviour is ever repaired. A config that
               still says "mixer" keeps working until the user next saves this tab, when the unknown-token
               rule re-homes it to "Cycles Windows". Don't rip the plumbing out. -->
          <!-- <ComboBoxItem Tag="mixer" Content="Audio Mixer"/> -->
        </ComboBox>

        <!-- Read-only: which two apps the mixer would balance right now. Resolved live from what's running,
             never picked manually. Collapsed while "Audio Mixer" is out of the picker above. -->
        <TextBlock x:Name="MixPairText" FontSize="11.5" Opacity="0.75" Margin="2,0,0,0"
                   TextWrapping="Wrap" Text="{loc:T Now mixing: (resolving…)}"/>

        <TextBlock Margin="0,22,0,6">
          <Run Text="{loc:T Show labels on}" FontWeight="Bold" FontSize="15.5" Foreground="{StaticResource HeadingInk}"/><Run Text="  "/><InlineUIContainer BaselineAlignment="Center"><Button Style="{DynamicResource HelpChip}" Click="HelpShowLabels_Click" Width="15" Height="15" FontSize="10" ToolTip="{loc:T Label modes help}" AutomationProperties.Name="{loc:T Label modes help}"/></InlineUIContainer>
        </TextBlock>
        <!-- The four Tag values are the stored tokens and must stay as they are (SliceLabelRule owns
             them) — only the display names may be reworded. -->
        <ComboBox x:Name="ShowSliceLabelsBox" Margin="0,2,0,0"
                  AutomationProperties.Name="{loc:T Show labels on}"
                  SelectionChanged="ShowSliceLabelsBox_SelectionChanged">
          <ComboBoxItem Tag="all-except-logos" Content="{loc:T 'Icons, not Logos'}"
                        ToolTip="{loc:T Label built-in icons only (default)}"/>
          <ComboBoxItem Tag="all" Content="{loc:T All Slices}"
                        ToolTip="{loc:T 'Label every slice, even artwork'}"/>
          <ComboBoxItem Tag="none" Content="{loc:T No Slices}"
                        ToolTip="{loc:T No labels anywhere on the wheel.}"/>
          <ComboBoxItem Tag="selected" Content="{loc:T Slices I Choose}"
                        ToolTip="{loc:T Choose per slice in its editor}"/>
        </ComboBox>

        <!-- Section-level Help chips: Triggers links to its own discrete Help topic; the tab-level chip
             below keeps the general "customize" topic. Mirrors SystemEditorControl's heading-chip pattern. -->
        <TextBlock Margin="0,18,0,6">
          <Run Text="{loc:T Triggers}" FontWeight="Bold" FontSize="15.5" Foreground="{StaticResource HeadingInk}"/><Run Text="  "/><InlineUIContainer BaselineAlignment="Center"><Button Style="{DynamicResource HelpChip}" Click="HelpTriggers_Click" Width="15" Height="15" FontSize="10" ToolTip="{loc:T Triggers help}" AutomationProperties.Name="{loc:T Triggers help}"/></InlineUIContainer>
        </TextBlock>

        <!-- Chord builder: each row = one live chord (a button + how it's combined), built in code from the
             detected controller's options. "+ Add another trigger" appends a row; every row stays live at once.
             4px left inset matches the tiles' Thickness(4) margin, so content lines up section-to-section. -->
        <!-- (Hold)/(Tap) captions: 2-button chords are hold + tap — the first button keeps the wheel up;
             the second just completes the chord. Column widths mirror AddTriggerRow (98 / 23 joiner / 108).
             ⚠ The rows must stay inside the right column's width — don't let the dropdowns size themselves
             here, or the ✕ button rides off the panel's right edge. -->
        <Grid Margin="4,3,0,0" HorizontalAlignment="Left">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="98"/>
            <ColumnDefinition Width="23"/>
            <ColumnDefinition Width="108"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{loc:T Hold:}" FontSize="10" Foreground="#999999" Margin="2,0,0,0"/>
          <TextBlock Grid.Column="2" Text="{loc:T Tap:}"  FontSize="10" Foreground="#999999" Margin="2,0,0,0"/>
        </Grid>
        <StackPanel x:Name="TriggerRows" Margin="4,1,0,0"/>
        <Button x:Name="AddTriggerBtn" Content="{loc:T + Add Another Trigger}" HorizontalAlignment="Left" Margin="4,4,0,0"
                Padding="10,2" Click="AddTriggerRow_Click"/>

        <!-- ── The Accessibility section lives on Settings ▸ Advanced, at the top of that tab's right
             column. SystemEditorControl owns TriggerActivation / SwapFnButtons / WheelIgnoresOppositeStick /
             AlwaysShowHub / ReduceMotion / Narration, and the Toggle⇄Swap soft-link state; this tab must
             not write any of them. ──────────────────────────────────────────────────────────────────── -->

      </StackPanel>
    </Grid>
  </ScrollViewer>

    <!-- Single tab-level Help chip, floating top-right. Overlays the scroll content (Panel.ZIndex) so it
         is always visible and never pushes the sections downward. -->
    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,18,0" Panel.ZIndex="1">
      <InlineUIContainer BaselineAlignment="Center"><Button Style="{DynamicResource HelpChip}" Click="HelpCustomize_Click" Width="19" Height="19" FontSize="13" ToolTip="{loc:T Customize help}" AutomationProperties.Name="{loc:T Customize help}"/></InlineUIContainer>
    </TextBlock>
  </Grid>
</UserControl>
