<UserControl x:Class="ControllerWheel.HelpEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="16,12,16,16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="215"/>
      <ColumnDefinition Width="18"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ── Left: back (link arrivals only) + search + the topic list (grouped, built in code). The language
         picker lives on the Advanced tab (SystemEditorControl); the pane follows the app language through
         SetLanguage(). The drawn flag swatches (BuildFlagGlyph) stay in this control's code-behind because
         both the Advanced tab and onboarding draw them. ── -->
    <DockPanel Grid.Column="0">
      <DockPanel DockPanel.Dock="Top">
        <!-- Back = the Material arrow-left-bold-circle icon (set in code via PackIconHelper); shown ONLY
             when a Help chip opened Help (SetBackVisible). Returns to the tab the user came from. -->
        <Button x:Name="BackBtn" DockPanel.Dock="Left" Visibility="Collapsed" Click="BackBtn_Click"
                Width="26" Height="26" Margin="0,0,7,0" Cursor="Hand">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <ContentPresenter x:Name="CP" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="CP" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <Grid>
          <TextBox x:Name="SearchBox" Padding="6,5" FontSize="13"
                   TextChanged="SearchBox_TextChanged" GotFocus="SearchBox_FocusChanged"
                   LostFocus="SearchBox_FocusChanged"/>
          <!-- Light-gray magnifying-glass watermark — hidden only while the box has text (see
               UpdateSearchGlyph); focus alone keeps it. -->
          <TextBlock x:Name="SearchGlyph" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                     Foreground="{StaticResource UiGhostInk}" IsHitTestVisible="False"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
        </Grid>
      </DockPanel>
      <TextBlock DockPanel.Dock="Top" x:Name="ContentsHeading" FontWeight="Bold" FontSize="15.5"
                 Foreground="{StaticResource HeadingInk}" Margin="0,12,0,0"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
        <StackPanel x:Name="TopicList"/>
      </ScrollViewer>
    </DockPanel>

    <!-- ── Right: the rendered topic ── -->
    <ScrollViewer x:Name="TopicScroller" Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="TopicBody" MaxWidth="560" HorizontalAlignment="Left"/>
    </ScrollViewer>
  </Grid>
</UserControl>
