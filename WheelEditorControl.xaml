<UserControl x:Class="ControllerWheel.WheelEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ControllerWheel"
             xmlns:local="clr-namespace:ControllerWheel">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="ListColumn" Width="210" MinWidth="130"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ── Left: slice list ─────────────────────────────────────── -->
    <!-- AllowDrop on the whole column: a reorder released a few px past the list's edge (bottom margin,
         over the buttons) still lands in SliceList_Drop instead of silently cancelling. -->
    <!-- ⚠ PreviewDragOver (TUNNELING, on the outermost element), never bubbling DragOver: something in a
         row's visual tree answers the drag first and leaves Effects=None, producing a no-drop cursor over
         the middle of a row. Tunneling from here fires before any descendant sees the event and the handler
         marks it Handled, so the drop target is uniform across the whole column by construction. -->
    <!-- TabNavigation=Local so the explicit TabIndex order below is honoured: the DockPanel declares
         Test Wheel FIRST (Dock=Bottom pattern), so the default document-order tabbing landed there
         before the slice list. Wanted flow: list → + − ▲ ▼ → Test Wheel → across into the editor. -->
    <DockPanel Grid.Column="0" AllowDrop="True" KeyboardNavigation.TabNavigation="Local"
               PreviewDragOver="SliceList_DragOver" Drop="SliceList_Drop">
      <Button x:Name="BtnTestWheel" DockPanel.Dock="Bottom" Content="{loc:T Test Wheel}" TabIndex="6"
              Margin="4,0,0,6" Padding="0,4" Click="BtnTestWheel_Click"
              ToolTip="{loc:T Open this wheel on screen}"/>
      <!-- Right margin 0 so the move buttons line up with the slice list's right edge. -->
      <Grid DockPanel.Dock="Bottom" Margin="4,4,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- "+"/"−" glyphs sit low in Segoe UI's em box; the negative-top/positive-bottom Padding
             re-centers them. Padding="0" lets them droop. -->
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Button x:Name="BtnAdd"    Content="+"  Width="33" FontSize="18" Padding="0,-2,0,2" VerticalContentAlignment="Center" ToolTip="{loc:T Add slice}"  AutomationProperties.Name="{loc:T Add slice}" Click="BtnAdd_Click" TabIndex="2"/>
          <Button x:Name="BtnRemove" Content="−"  Width="33" FontSize="18" Padding="0,-2,0,2" VerticalContentAlignment="Center" ToolTip="{loc:T Remove slice}" AutomationProperties.Name="{loc:T Remove slice}" Click="BtnRemove_Click" Margin="3,0,0,0" TabIndex="3"/>
        </StackPanel>
        <!-- Pinned left-to-right: "6 / 12" is a count over a cap, and in an RTL paragraph the spaces around "/"
             keep it a neutral (not a numeric separator), so the bidi algorithm would display it as "12 / 6". -->
        <TextBlock x:Name="SliceCountText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FlowDirection="LeftToRight" Foreground="#888" FontSize="11"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="BtnUp"     Content="▲"  Width="33" ToolTip="{loc:T Move up}"   AutomationProperties.Name="{loc:T Move slice up}"   Click="BtnUp_Click" TabIndex="4"/>
          <Button x:Name="BtnDown"   Content="▼"  Width="33" ToolTip="{loc:T Move down}" AutomationProperties.Name="{loc:T Move slice down}" Click="BtnDown_Click" Margin="3,0,0,0" TabIndex="5"/>
        </StackPanel>
      </Grid>
      <Grid>
      <ListBox x:Name="SliceList" SelectionChanged="SliceList_SelectionChanged" TabIndex="1"
               BorderThickness="1" Margin="4,4,0,0"
               VirtualizingPanel.IsVirtualizing="False"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ToolTip="{loc:T Drop an .exe to add a Launch slice}"
               AllowDrop="True"
               PreviewMouseLeftButtonDown="SliceList_PreviewMouseLeftButtonDown"
               PreviewMouseMove="SliceList_PreviewMouseMove"
               Drop="SliceList_Drop">
        <!-- ⚠ Custom container template required: the default Aero2 ListBoxItem HARDCODES its selection
             brushes and paints a selected item GREY whenever the list is unfocused. One IsSelected trigger
             with NO focus condition keeps the selected slice the same blue focused or not. -->
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="1"
                          BorderBrush="Transparent" CornerRadius="2" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background"  Value="#1F26A0DA"/>
                      <Setter TargetName="Bd" Property="BorderBrush" Value="#A826A0DA"/>
                    </Trigger>
                    <!-- Selected — regardless of keyboard focus. -->
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background"  Value="#3D26A0DA"/>
                      <Setter TargetName="Bd" Property="BorderBrush" Value="#FF26A0DA"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="2,3" ToolTip="{loc:T Drag to reorder}">
              <Image Source="{Binding Preview}" Width="20" Height="20" Margin="0,0,8,0"
                     DockPanel.Dock="Left" VerticalAlignment="Center"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
              <local:WheelMiniature Width="22" Height="22" DockPanel.Dock="Right"
                     Margin="6,0,2,0" VerticalAlignment="Center"
                     SliceCount="{Binding Total}" HighlightIndex="{Binding Index}"
                     ToolTip="{loc:T Position on the wheel}"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ListLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding ActionType}" Foreground="#888" FontSize="11"/>
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <!-- Empty-wheel note (an empty wheel = that side disabled); overlays the empty list. -->
      <TextBlock x:Name="EmptyWheelNote" Visibility="Collapsed" IsHitTestVisible="False"
                 Text="{loc:T Wheel disabled. Add at least 1 slice to enable this wheel.}"
                 Foreground="#99000000" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                 TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="16,0"/>
      </Grid>
    </DockPanel>

    <!-- ── Splitter ──────────────────────────────────────────────── -->
    <!-- Transparent grab strip: matches the page background but still drags to resize the columns. Not a
         Tab stop — it drags, it doesn't invoke, so Space/Enter on it does nothing and Tab should skip
         straight from the slice list into the editor form. -->
    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Focusable="False"
                  Background="Transparent" ResizeBehavior="PreviousAndNext"
                  DragCompleted="ListSplitter_DragCompleted"/>

    <!-- ── Right: editor form ────────────────────────────────────── -->
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="EditorPanel" Margin="16,10,16,16" IsEnabled="False">

        <TextBlock Text="{loc:T No slice selected}" x:Name="EmptyHint"
                   Foreground="#AAA" FontStyle="Italic"
                   HorizontalAlignment="Center" Margin="0,40,0,0"/>

        <StackPanel x:Name="EditorFields" Visibility="Collapsed">

          <!-- Style card: the Label field + Show Label ride in their own row at the top, above the
               always-open icon/color editor. The section heading's hairline rule starts to the right of the
               word and runs to the form column's right edge, vertically centred on the text. -->
          <Grid Margin="0,2,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0">
              <Run Text="{loc:T Style}" FontWeight="Bold" FontSize="15.5" Foreground="{StaticResource HeadingInk}"/>
            </TextBlock>
            <Border Grid.Column="1" Height="1" Margin="10,0,0,0" VerticalAlignment="Center"
                    SnapsToDevicePixels="True" Background="{StaticResource UiCardBorder}"/>
          </Grid>
          <Border x:Name="IconColorPanel" Margin="0,0,0,0"
                  Background="{StaticResource UiCardBg}" BorderBrush="{StaticResource UiCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <!-- Same wheel-position indicator as the slice-list rows — shows where this slice sits. -->
                <local:WheelMiniature x:Name="LabelSliceIndicator" Width="30" Height="30"
                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                      ToolTip="{loc:T Position on the wheel}"/>
                <TextBox x:Name="LabelBox" Padding="4,5" MaxLength="40" AutomationProperties.Name="{loc:T Slice label}"
                         FontSize="17" FontWeight="Bold" Width="165"
                         TextChanged="EditorField_Changed"/>
                <CheckBox x:Name="ShowLabelCheck" Content="{loc:T Show label}"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          ToolTip="{loc:T 'Show this slice\'s label'}"
                          Checked="ShowLabelCheck_Changed" Unchecked="ShowLabelCheck_Changed">
                  <!-- Custom template so the n/a state (custom-logo games) shows a horizontal DASH, not an
                       empty/checked box; the code sets IsChecked=null + reduced Opacity for that state. -->
                  <CheckBox.Template>
                    <ControlTemplate TargetType="CheckBox">
                      <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="14" Height="14" CornerRadius="2" VerticalAlignment="Center"
                                BorderBrush="#8A8A8A" BorderThickness="1" Background="White" SnapsToDevicePixels="True">
                          <Grid>
                            <Path x:Name="check" Visibility="Collapsed" Stretch="Uniform" Margin="2,3"
                                  Stroke="#3C405B" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M0,3 L2.5,6 L8,0"/>
                            <Rectangle x:Name="dash" Visibility="Collapsed" Width="8" Height="2" RadiusX="1" RadiusY="1"
                                       Fill="#8A8A8A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Grid>
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                      </StackPanel>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                          <Setter TargetName="dash" Property="Visibility" Value="Visible"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </CheckBox.Template>
                </CheckBox>
                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0">
                  <InlineUIContainer BaselineAlignment="Center"><Button Style="{DynamicResource HelpChip}" Click="HelpColorLabel_Click" Width="15" Height="15" FontSize="10" ToolTip="{loc:T 'Label, icon &amp; color help'}" AutomationProperties.Name="{loc:T 'Label, icon and colour help'}"/></InlineUIContainer>
                </TextBlock>
              </StackPanel>
              <local:IconColorPickerControl x:Name="InlineIconPicker" MaxWidth="430" Margin="0,12,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </StackPanel>
          </Border>

          <!-- Action: category tabs. The shared body (TabBody) is relocated by code-behind into whichever
               tab is selected. -->
          <!-- Sub-tabs use the smaller, lighter SubTabItem headers over white content; only the
               window-level tabs use the big rounded style. -->
          <Grid Margin="0,18,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0">
              <Run Text="{loc:T Action}" FontWeight="Bold" FontSize="15.5" Foreground="{StaticResource HeadingInk}"/>
            </TextBlock>
            <Border Grid.Column="1" Height="1" Margin="10,0,0,0" VerticalAlignment="Center"
                    SnapsToDevicePixels="True" Background="{StaticResource UiCardBorder}"/>
          </Grid>
          <TabControl x:Name="CatTabs" ItemContainerStyle="{DynamicResource SubTabItem}" Margin="0,0,0,0"
                      Background="White" SelectionChanged="CatTabs_SelectionChanged">
            <!-- Single-row header panel: the SubTabItem style resolves via DynamicResource (it lives at the
                 window level, not in scope at UserControl parse time), so on the very FIRST render — e.g.
                 jumping straight to an unconfigured slice — the tabs briefly use default (wider) chrome. The
                 default wrapping TabPanel would push them onto 2 justified rows; a StackPanel never wraps. -->
            <TabControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </TabControl.ItemsPanel>
            <TabItem>
              <StackPanel x:Name="TabBody" Margin="8,8,8,8">

                <!-- Second row exists for the "Hold to confirm" checkbox alone: when the two dropdowns leave
                     it no room, ApplyConfirmWrap drops it here (still right-aligned) rather than letting the
                     row squeeze its label off the edge. Empty and zero-height the rest of the time. -->
                <Grid x:Name="ActionRow" SizeChanged="ActionRow_SizeChanged">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <!-- ⚠ A FLOOR, not a cap: the column is Auto and a ComboBox sizes to its WIDEST ITEM, so
                       these only pad out a SHORT list and can never clip a long one. Both boxes are shared by
                       every action group, so a floor set for one group's longest entry pads every other
                       group's. Tuned by eye on the Radiata group's Arcade pair.
                       ⚠⚠ A floor AT OR BELOW the widest item does nothing whatever — the sub-dropdown's
                       "Arcade Launcher" measures ~124 DIP, so every value under that renders identically and
                       a small nudge there looks like the edit never landed. Check the content width before
                       concluding a change had no effect. -->

                  <ComboBox x:Name="TypeBox" Grid.Column="0" MinWidth="98" VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:T Action type}"
                            FontSize="13" SelectionChanged="TypeBox_SelectionChanged"/>
                  <!-- Type-locked readout: an EXISTING slice shows its type as static text (change the
                       category by deleting + re-adding); the dropdowns stay for NEW slices only. -->
                  <TextBlock x:Name="TypeLockedText" Grid.Column="0" VerticalAlignment="Center"
                             FontSize="13" FontWeight="SemiBold" Visibility="Collapsed"
                             ToolTip="{loc:T Action type — fixed once saved}"/>
                  <ComboBox x:Name="SubTypeBox" Grid.Column="1" MinWidth="138" VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:T Action subtype}"
                            FontSize="13" Margin="6,0,0,0" Visibility="Collapsed"
                            SelectionChanged="SubTypeBox_SelectionChanged"/>
                  <!-- Single help link for Switch Audio Output, to the right of its dropdown (shown only for that type). -->
                  <TextBlock x:Name="AudioHelpLink" Grid.Column="2" VerticalAlignment="Center"
                             Margin="8,0,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
                    <InlineUIContainer BaselineAlignment="Center"><Button Style="{DynamicResource HelpChip}" Click="HelpSwitchAudio_Click" Width="15" Height="15" FontSize="10" ToolTip="{loc:T Switch Audio help}" AutomationProperties.Name="{loc:T Switch Audio help}"/></InlineUIContainer>
                  </TextBlock>
                  <CheckBox x:Name="ConfirmCheck" Grid.Column="3" Content="{loc:T Hold to confirm}"
                            VerticalAlignment="Center" Margin="4,0,0,0"
                            ToolTip="{loc:T Require a short hold before firing}"
                            Checked="ConfirmCheck_Changed" Unchecked="ConfirmCheck_Changed"/>
                </Grid>

              <!-- Path (launch / script) -->
              <StackPanel x:Name="PathRow" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock>
                  <Run x:Name="PathLabel" Text="{loc:T Executable Path}" FontWeight="SemiBold"/><Run Text="  "/><InlineUIContainer BaselineAlignment="Center"><Button Style="{DynamicResource HelpChip}" Click="HelpAppSlices_Click" Width="15" Height="15" FontSize="10" ToolTip="{loc:T Launch &amp; script slices help}" AutomationProperties.Name="{loc:T Launch and script help}"/></InlineUIContainer>
                </TextBlock>
                <!-- Browse-only: there is no free-text path field for Launch App — Browse picks the exe and
                     the readout below the buttons shows the pick. Script slices share the row (the readout wraps long
                     paths). PathBox is the hidden storage every code path reads/writes. -->
                <StackPanel Margin="0,3,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnBrowsePath" Content="{loc:T Browse for App…}" Padding="10,3"
                            Click="BtnBrowsePath_Click"/>
                    <Button x:Name="BtnPickApp" Content="{loc:T Installed Apps…}" Padding="10,3"
                            Margin="6,0,0,0" Click="BtnPickApp_Click"
                            ToolTip="{loc:T Pick from Start-menu apps}"/>
                  </StackPanel>
                  <TextBlock x:Name="PathReadout" Margin="0,6,0,0"
                             Foreground="#888" FontSize="11.5" TextWrapping="Wrap"
                             Text="{loc:T (no app chosen)}"/>
                </StackPanel>
                <TextBox x:Name="PathBox" Visibility="Collapsed" TextChanged="EditorField_Changed"/>
              </StackPanel>

              <!-- Behavior (launch) -->
              <StackPanel x:Name="BehaviorRow" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="{loc:T Behavior}" FontWeight="SemiBold"/>
                <ComboBox x:Name="BehaviorBox" Margin="0,3,0,0"
                          AutomationProperties.Name="{loc:T Launch behaviour}"
                          FontSize="13" SelectionChanged="BehaviorBox_SelectionChanged">
                  <ComboBoxItem Tag="run"    Content="{loc:T Run (Launch → Focus)}"/>
                  <ComboBoxItem Tag="toggle" Content="{loc:T Toggle (Launch ↔ Close)}"/>
                </ComboBox>
              </StackPanel>

              <!-- There is deliberately no "Process Name (if different)" field: it can never work for Store
                   apps (their windows belong to ApplicationFrameHost, so the running-instance check can't
                   match) and the executable's filename is the right answer nearly everywhere else. The
                   executor still honours a process override stored in an existing config. -->

              <!-- Launcher / storefront (launcher) -->
              <StackPanel x:Name="LauncherRow" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock>
                  <Run Text="{loc:T Storefront}" FontWeight="SemiBold"/><Run Text="  "/><InlineUIContainer BaselineAlignment="Center"><Button Style="{DynamicResource HelpChip}" Click="HelpAppSlices_Click" Width="15" Height="15" FontSize="10" ToolTip="{loc:T Storefront help}" AutomationProperties.Name="{loc:T Storefront help}"/></InlineUIContainer>
                </TextBlock>
                <ComboBox  x:Name="LauncherBox" Margin="0,3,0,0" FontSize="13" AutomationProperties.Name="{loc:T Storefront}"
                           SelectionChanged="LauncherBox_SelectionChanged"/>
              </StackPanel>

              <!-- URL (http, url, discord-join types) -->
              <StackPanel x:Name="UrlRow" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock>
                  <Run x:Name="UrlLabel" Text="{loc:T URI}" FontWeight="SemiBold"/><Run Text="  "/><InlineUIContainer BaselineAlignment="Center"><Button Style="{DynamicResource HelpChip}" Click="HelpUri_Click" Width="15" Height="15" FontSize="10" ToolTip="{loc:T URI help}" AutomationProperties.Name="{loc:T URI help}"/></InlineUIContainer>
                </TextBlock>
                <TextBox   x:Name="UrlBox" Margin="0,3,0,0" AutomationProperties.Name="{loc:T URI}"
                           TextChanged="EditorField_Changed" LostFocus="UrlBox_LostFocus"/>
                <!-- How to get a voice-channel link (shown only for Join/Leave Voice Channel). -->
                <TextBlock x:Name="DiscordUrlTip" Visibility="Collapsed" Foreground="#888" FontSize="11"
                           Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{loc:T 'In Discord, right-click the voice channel → Copy Link, then paste it here.'}"/>
              </StackPanel>

              <!-- Discord not configured yet: shown until the user's own app credentials are set (via the
                   mini setup wizard). It replaces the URL field for Join/Leave Voice Channel, and stands
                   alone for Deafen and Mute Me, which have no field of their own. -->
              <StackPanel x:Name="DiscordConfigRow" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Margin="0,0,0,6">
                  <Run Text="{loc:T One-time Discord setup required}" FontWeight="SemiBold"/><Run Text="  "/><InlineUIContainer BaselineAlignment="Center"><Button Style="{DynamicResource HelpChip}" Click="HelpDiscord_Click" Width="15" Height="15" FontSize="10" ToolTip="{loc:T Discord setup help}" AutomationProperties.Name="{loc:T Discord setup help}"/></InlineUIContainer>
                </TextBlock>
                <Button x:Name="BtnConfigureDiscord" Content="{loc:T Configure Discord Integration…}"
                        HorizontalAlignment="Left" Padding="12,5" Click="BtnConfigureDiscord_Click"/>
              </StackPanel>

              <!-- Installed Game picker -->
              <StackPanel x:Name="GameRow" Visibility="Collapsed" Margin="0,12,0,0">
                <!-- Hidden when type-locked: the static type readout already reads "Installed Game". -->
                <TextBlock x:Name="GameRowLabel" Text="{loc:T Installed Game}" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                  <!-- MinWidth is a local floor at 2× the themed ComboBox default (120): game titles are
                       long, so a short one shouldn't leave the picker a stub. It still grows with a wider
                       title, up to the style's MaxWidth. -->
                  <ComboBox x:Name="GameBox" FontSize="13" MinWidth="240" AutomationProperties.Name="{loc:T Installed game}"
                            SelectionChanged="GameBox_SelectionChanged"/>
                  <Button x:Name="BtnRefreshGames" Content="↻" Width="28" Padding="0"
                          Margin="4,0,0,0" FontSize="14" FontWeight="Light" ToolTip="{loc:T Rescan installed games}"
                          AutomationProperties.Name="{loc:T Rescan installed games}"
                          Click="BtnRefreshGames_Click"/>
                </StackPanel>
                <TextBlock x:Name="GameLaunchUrl" Foreground="#888" FontSize="11" Margin="0,3,0,0"
                           TextWrapping="Wrap" TextTrimming="None"/>
              </StackPanel>

              <!-- Key combo (keypress type + discord mute/deafen/overlay). For the KEYPRESS type only,
                   code-behind styles KeysBox half-width with enlarged text (UpdateKeysStyling). -->
              <StackPanel x:Name="KeysRow" Visibility="Collapsed" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="KeysLabel" Text="{loc:T Key Combo}" FontWeight="SemiBold"/>
                  <!-- Help chip → the "key-combo" topic. A SIBLING of KeysLabel, not an inline, because
                       code-behind assigns KeysLabel.Text and that would wipe inlines. Keypress-only
                       (UpdateFieldVisibility): the Discord/Steam key fields have their own topics. -->
                  <TextBlock x:Name="KeysHelpLink" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed">
                    <InlineUIContainer BaselineAlignment="Center"><Button Style="{DynamicResource HelpChip}" Click="HelpKeyCombo_Click" Width="15" Height="15" FontSize="10" ToolTip="{loc:T Key combo format help}" AutomationProperties.Name="{loc:T Key combo help}"/></InlineUIContainer>
                  </TextBlock>
                </StackPanel>
                <TextBox   x:Name="KeysBox" Margin="0,3,0,0" AutomationProperties.Name="{loc:T Key combo}"
                           TextChanged="EditorField_Changed"/>
                <TextBlock x:Name="KeysHint" Foreground="#888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="{loc:T e.g. Win+D | Ctrl+Shift+Esc | Alt+F4 | VolUp | PlayPause}"/>
              </StackPanel>

              <!-- Device pickers (switch-audio type). A plain TextBox + a ▾ button dropping the LIVE devices:
                   pick what's plugged in, or type a partial name — storage is a substring match, so existing
                   slices and unplugged devices keep working.
                   ⚠ DO NOT use an editable ComboBox here. An editable ComboBox keeps TWO sources of truth
                   for what's shown (SelectedItem and Text, reconciled inside the framework's own
                   OnSelectionChanged → Update pass), so a mouse pick, a forced Text write and the auto-save's
                   list Refresh race and the closed box comes back blank. A TextBox has one source of truth
                   and renders what it's given. -->
              <StackPanel x:Name="DeviceRow" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="{loc:T Output Device}" FontWeight="SemiBold"/>
                <Grid Margin="0,3,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="DeviceBox" Grid.Column="0" AutomationProperties.Name="{loc:T Output device}" TextChanged="EditorField_Changed"/>
                  <Button x:Name="DevicePickBtn" Grid.Column="1" Content="▾" Width="24" Margin="4,0,0,0"
                          AutomationProperties.Name="{loc:T Pick output device}"
                          Padding="0" FontSize="11" Click="DevicePickBtn_Click"
                          ToolTip="{loc:T Pick a connected audio output}"/>
                </Grid>
                <TextBlock Text="{loc:T Mic Device}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <Grid Margin="0,3,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="MicDeviceBox" Grid.Column="0" AutomationProperties.Name="{loc:T Mic device}" TextChanged="EditorField_Changed"/>
                  <Button x:Name="MicDevicePickBtn" Grid.Column="1" Content="▾" Width="24" Margin="4,0,0,0"
                          AutomationProperties.Name="{loc:T Pick microphone}"
                          Padding="0" FontSize="11" Click="MicDevicePickBtn_Click"
                          ToolTip="{loc:T Pick a connected microphone}"/>
                </Grid>
                <!-- The blank-field behaviour is documented in the "Switch Audio Output" Help topic, reached
                     by the Help chip beside the type dropdown (AudioHelpLink) — not inline here. -->
              </StackPanel>

              <!-- Volume level (system / volume-set command) -->
              <StackPanel x:Name="LevelRow" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="{loc:T Volume Level (0–100)}" FontWeight="SemiBold"/>
                <TextBox   x:Name="LevelBox" Margin="0,3,0,0" Width="80" AutomationProperties.Name="{loc:T 'Volume level, 0 to 100'}"
                           HorizontalAlignment="Left"
                           TextChanged="EditorField_Changed"/>
              </StackPanel>

              <!-- Toggle Power Plan (system / power-plan command): firing flips between the two plans. -->
              <StackPanel x:Name="PowerPlanRow" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="{loc:T Toggle Between}" FontWeight="SemiBold"/>
                <ComboBox  x:Name="PowerPlanBox" Margin="0,3,0,0"
                           AutomationProperties.Name="{loc:T First power plan}"
                           FontSize="13" SelectionChanged="PowerPlanBox_SelectionChanged"/>
                <TextBlock Text="{loc:T and}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ComboBox  x:Name="PowerPlanBoxB" Margin="0,3,0,0"
                           AutomationProperties.Name="{loc:T Second power plan}"
                           FontSize="13" SelectionChanged="PowerPlanBox_SelectionChanged"/>
              </StackPanel>

              <!-- Log In after Reboot (system / reboot command): checked (default) = restart with
                   Automatic Restart Sign-On (shutdown /g); unchecked = a traditional restart (shutdown /r),
                   landing at the sign-in screen when one is due. -->
              <StackPanel x:Name="RebootRow" Visibility="Collapsed" Margin="0,12,0,0">
                <CheckBox x:Name="RebootLoginCheck" Content="{loc:T Log In after Reboot}" IsChecked="True"
                          ToolTip="{loc:T Sign back in after the restart}"
                          Checked="RebootLoginCheck_Changed" Unchecked="RebootLoginCheck_Changed"/>
              </StackPanel>

              <!-- OBS target (obs type: scene / audio-source name; label + hint set per command in code) -->
              <StackPanel x:Name="ObsTargetRow" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock x:Name="ObsTargetLabel" Text="{loc:T Scene Name}" FontWeight="SemiBold"/>
                <TextBox   x:Name="ObsTargetBox" Margin="0,3,0,0" Width="300" HorizontalAlignment="Left"
                           AutomationProperties.Name="{loc:T OBS scene name}"
                           TextChanged="EditorField_Changed"/>
                <TextBlock x:Name="ObsTargetHint" Foreground="#888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>

              <!-- OBS not configured yet: the connection (port + password) lives in Settings ▸ Advanced ▸
                   Integrations; this button opens that same pane so an OBS slice can be finished in place. -->
              <StackPanel x:Name="ObsConfigRow" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Margin="0,0,0,4">
                  <Run Text="{loc:T One-time OBS setup required}" FontWeight="SemiBold"/><Run Text="  "/><InlineUIContainer BaselineAlignment="Center"><Button Style="{DynamicResource HelpChip}" Click="HelpObs_Click" Width="15" Height="15" FontSize="10" ToolTip="{loc:T OBS setup help}" AutomationProperties.Name="{loc:T OBS setup help}"/></InlineUIContainer>
                </TextBlock>
                <Button x:Name="BtnConfigureObs" Content="{loc:T Configure OBS Integration…}"
                        HorizontalAlignment="Left" Padding="12,5" Click="BtnConfigureObs_Click"/>
              </StackPanel>

              <!-- Chat button (text-chat type): Try Game Default vs a Custom key, with the custom key's
                   small text field appearing right next to the dropdown only when Custom is picked. -->
              <StackPanel x:Name="ChatButtonRow" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock>
                  <Run Text="{loc:T Chat Button:}" FontWeight="SemiBold"/><Run Text="  "/><InlineUIContainer BaselineAlignment="Center"><Button Style="{DynamicResource HelpChip}" Click="HelpTextChat_Click" Width="15" Height="15" FontSize="10" ToolTip="{loc:T Chat button help}" AutomationProperties.Name="{loc:T Chat button help}"/></InlineUIContainer>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                  <ComboBox x:Name="ChatButtonBox" FontSize="13" AutomationProperties.Name="{loc:T Chat button}"
                            SelectionChanged="ChatButtonBox_SelectionChanged">
                    <ComboBoxItem Tag="default" Content="{loc:T Try Game Default}"/>
                    <ComboBoxItem Tag="custom"  Content="{loc:T Custom…}"/>
                  </ComboBox>
                  <TextBox x:Name="ChatCustomKeyBox" Visibility="Collapsed" Width="40" Margin="6,0,0,0"
                           AutomationProperties.Name="{loc:T Custom chat key}"
                           HorizontalContentAlignment="Center" TextChanged="EditorField_Changed"/>
                </StackPanel>
                <!-- The Game Default vs Custom explanation lives in the "Text Chat" Help topic behind the
                     Help chip above, not inline here. -->
              </StackPanel>

              <!-- Chat message (text-chat type) -->
              <StackPanel x:Name="ChatTextRow" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="{loc:T Message to Send}" FontWeight="SemiBold"/>
                <TextBox   x:Name="ChatTextBox" Margin="0,3,0,0" AutomationProperties.Name="{loc:T Message to send}"
                           TextChanged="EditorField_Changed"/>
              </StackPanel>

              <!-- Sequence steps (sequence type) -->
              <StackPanel x:Name="SequenceRow" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock>
                  <Run Text="{loc:T Steps (one per line)}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBox   x:Name="SequenceBox" Margin="0,3,0,0" AutomationProperties.Name="{loc:T 'Steps, one per line'}"
                           Height="120" AcceptsReturn="True" TextWrapping="NoWrap"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                           FontFamily="Consolas" FontSize="12"
                           TextChanged="EditorField_Changed"/>
              </StackPanel>

              <!-- Non-blocking validity hint: quiet gray, because the flagged field's red border carries the
                   attention. -->
              <TextBlock x:Name="ValidationHint" Visibility="Collapsed" Margin="0,12,0,0"
                         TextWrapping="Wrap" FontSize="11" Foreground="#888"/>

              </StackPanel>
            </TabItem>
            <!-- Headers are stamped from WheelEditorControl.Categories at construction (SyncCategoryTabHeaders)
                 so a category rename can never leave the tab strip stale — these are placeholders, and the
                 COUNT/ORDER must still mirror the Categories array. -->
            <TabItem/>
            <TabItem/>
            <TabItem/>
            <TabItem/>
            <!-- Spare placeholder: the taxonomy is 5 categories, so SyncCategoryTabHeaders keeps this one
                 collapsed. It stays so a future runtime-added category has a shell to claim — a collapsed
                 tab can't be selected, and the placeholders are last, so index alignment holds. -->
            <TabItem/>
          </TabControl>

          <!-- Type-locked host: EXISTING slices show the action body WITHOUT the category tabs — TabBody is
               reparented here and the TabControl above collapses. -->
          <!-- Margin must stay 0: with the type locked the tab strip above is Collapsed, so any top margin
               here stacks on the "Action" heading's own 6px bottom margin and leaves a visibly empty band.
               Unlocked, the tabs supply the gap themselves and this Border is hidden. -->
          <Border x:Name="LockedBody" Visibility="Collapsed" Margin="0"
                  Background="White" BorderBrush="#D5CFC0" BorderThickness="1" CornerRadius="3"/>

          <!-- Add / remove / reorder in the slice list save automatically; only field edits need Save. -->
          <DockPanel Margin="0,14,0,0">
            <Button x:Name="BtnTest" Content="{loc:T ▶ Test Action}" DockPanel.Dock="Right" Padding="10,5"
                    Click="BtnTest_Click"
                    ToolTip="{loc:T 'Run now, unsaved edits included'}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
              <Button x:Name="BtnSave" Content="{loc:T Save Slice}" Margin="0,0,8,0" Padding="12,5" IsEnabled="False"
                      Click="BtnSave_Click"
                      ToolTip="{loc:T Save your edits to this slice}"/>
              <Button x:Name="BtnRevert" Content="{loc:T Revert}" Padding="10,5" IsEnabled="False"
                      Click="BtnRevert_Click"
                      ToolTip="{loc:T Discard your unsaved edits}"/>
            </StackPanel>
          </DockPanel>

        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
