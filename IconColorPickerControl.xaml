<UserControl x:Class="ControllerWheel.IconColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ControllerWheel"
             xmlns:local="clr-namespace:ControllerWheel">
  <!-- Shared icon + tint editor. NO OK/Cancel — the host confirms (the dialog's OK, the slice editor's Save
       Slice for a NEW slice, or auto-save for an existing one). -->
  <UserControl.Resources>
    <!-- Palette swatch. Hover must NOT change the fill, only the outline, so the colour under the cursor
         still reads true. -->
    <Style x:Key="Swatch" TargetType="Button">
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3"
                    BorderBrush="#33000000" BorderThickness="1" SnapsToDevicePixels="True"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="Black"/>
                <Setter TargetName="b" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Paired swatch: one chip = a dark base over its light equivalent (the variant dark slice materials
         use). Clicking picks BOTH — the app renders whichever matches the wheel material. -->
    <Style x:Key="PairSwatch" TargetType="Button">
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- The colour halves fill a clipped base; the hover outline MUST be a separate border later in
                 the Grid so it draws on top of every edge instead of the swatch fill covering it. -->
            <Grid SnapsToDevicePixels="True">
              <Border CornerRadius="3" ClipToBounds="True" Background="Transparent"><ContentPresenter/></Border>
              <Border x:Name="edge" CornerRadius="3" BorderBrush="#33000000" BorderThickness="1"
                      IsHitTestVisible="False" SnapsToDevicePixels="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="edge" Property="BorderBrush" Value="Black"/>
                <Setter TargetName="edge" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A glyph button that FILLS the logo tool strip's height. No background or border of its own — the
         strip provides the colour and hover darkens this one cell. The glyph is the button's CONTENT, not
         part of the template, so code can rotate it / swap it for a checkmark (the reload spinner). -->
    <Style x:Key="StripBtn" TargetType="Button">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#2C3048"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <DockPanel>

    <!-- The icon "well": the whole roundrect is the click-target for the icon grid. -->
    <!-- InvokableBorder keeps identical Border behaviour — the type filter, the code-behind's
         Background/BorderBrush writes, and the bubbling MouseLeftButtonUp all still apply — and adds focus,
         Space/Enter, and a UIA Invoke that run the SAME OpenIconGrid (wired in the ctor). -->
    <local:InvokableBorder x:Name="IconWell" Width="84" Height="84" CornerRadius="6" Background="White" DockPanel.Dock="Left"
            BorderBrush="{StaticResource UiChipBorder}" BorderThickness="1" Cursor="Hand" ClipToBounds="True"
            VerticalAlignment="Top" MouseLeftButtonUp="Preview_Click" ToolTip="{loc:T Change Icon…}"
            AutomationProperties.Name="{loc:T Change icon}" FocusVisualStyle="{DynamicResource AccessFocusVisual}"
            AllowDrop="True" DragOver="Well_DragOver" DragLeave="Well_DragLeave" Drop="Well_Drop">
      <Grid>
        <!-- The glyph Source is baked with the material's own icon treatment through the wheel's drawing
             helpers (RadialMenuControl.RenderPreviewIcon). For the outer-rim materials the bake canvas is
             padded by the rim width, so the Image scales a slightly larger bitmap down — that's what keeps
             the rim-to-glyph proportion matching the wheel instead of clipping the rim at the Image bounds. -->
        <Image x:Name="PreviewIcon" Width="67" Height="67" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <!-- Top stripe: ALWAYS present; text set in UpdatePreview. Deliberately NOT a Button — the whole
             well is the click target, and MouseLeftButtonUp must bubble from here to IconWell's handler. -->
        <Border x:Name="LogoStripe" Height="16" VerticalAlignment="Top" Background="#3C405B">
          <TextBlock x:Name="LogoStripeText" Text="{loc:T Edit}" FontSize="9" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <!-- Logo TOOL STRIP: same 16px height and fill as the stripe above, so the two frame the preview as
             a matched pair. ◀ ▶ (cycle the downloaded logos) float LEFT, reload floats RIGHT; all three are
             Material vectors rather than text so they match in weight as well as box. The strip appears when
             EITHER control applies and each button hides independently — see UpdateStripVisibility. -->
        <Border x:Name="LogoToolStrip" Height="16" VerticalAlignment="Bottom" Background="#3C405B"
                Visibility="Collapsed">
          <DockPanel LastChildFill="False">
            <Button x:Name="LogoPrevBtn" Style="{StaticResource StripBtn}" DockPanel.Dock="Left"
                    Click="LogoPrev_Click" ToolTip="{loc:T Previous logo}" AutomationProperties.Name="{loc:T Previous logo}">
              <Image x:Name="PrevGlyph" Width="12" Height="12"/>
            </Button>
            <Button x:Name="LogoNextBtn" Style="{StaticResource StripBtn}" DockPanel.Dock="Left"
                    Click="LogoNext_Click" ToolTip="{loc:T Next logo}" AutomationProperties.Name="{loc:T Next logo}">
              <Image x:Name="NextGlyph" Width="12" Height="12"/>
            </Button>
            <!-- Installed-game slices only (host opt-in): fetch/refresh the game's transparent logo. -->
            <Button x:Name="FetchLogoBtn" Style="{StaticResource StripBtn}" DockPanel.Dock="Right"
                    Click="FetchLogo_Click"
                    ToolTip="{loc:T 'Use the game\'s logo as the icon'}" AutomationProperties.Name="{loc:T Fetch game logo}">
              <!-- A vector Material icon (set in code: Refresh / Check) rotates cleanly around its exact
                   center — a font glyph's ascent/descent padding makes it sit low and wobble when spun. -->
              <Image x:Name="FetchGlyph" Width="12" Height="12" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                  <RotateTransform x:Name="FetchRotate"/>
                </Image.RenderTransform>
              </Image>
            </Button>
          </DockPanel>
        </Border>
      </Grid>
    </local:InvokableBorder>

    <!-- Top/left-aligned so the column sizes to the palette width — Reset docks to that same right edge. -->
    <StackPanel Margin="16,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">

      <!-- One row of paired chips (dark base over its light equivalent), built in code — see BuildPalette. -->
      <StackPanel x:Name="Palette"/>

      <DockPanel Margin="0,10,0,0">
        <!-- The Hex field is docked FIRST so it always gets its full width; the Reset button is the fill child
             and takes whatever is left, wrapping its caption when a long translation doesn't fit. Docking the
             button first lets a long caption claim the row and clip the field. -->
        <!-- The row reads with the window (label on the right in Arabic); only the hex FIELD is pinned left-to-right,
             because a hex code is a Latin token whatever the language. -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,8,0">
          <TextBlock Text="{loc:T Hex}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock Text="#" FontSize="14" Foreground="{StaticResource UiMutedInk}" VerticalAlignment="Center" Margin="0,0,1,0"/>
          <!-- The hex field always shows the AUTHORED colour, which is material-NEUTRAL: on a dark slice
               material the box reads the base tone while the well beside it previews the near-white the
               wheel will actually paint. That's intended — the field is what gets stored, and a typed value
               is taken as exact and painted verbatim on every material. -->
          <TextBox x:Name="HexBox" FontFamily="Consolas" FontSize="14" Width="65" MaxLength="7" Padding="4,4"
                   FlowDirection="LeftToRight"
                   AutomationProperties.Name="{loc:T Colour hex value}"
                   VerticalAlignment="Center" VerticalContentAlignment="Center" TextChanged="HexBox_TextChanged"
                   ToolTip="{loc:T Exact colour — painted verbatim}"/>
        </StackPanel>
        <Button x:Name="ResetBtn" HorizontalAlignment="Right" Padding="8,4" Click="Reset_Click">
          <TextBlock Text="{loc:T Reset to Default}" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
      </DockPanel>
    </StackPanel>
  </DockPanel>
</UserControl>
