<Window x:Class="ControllerWheel.ObsSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ControllerWheel"
        xmlns:local="clr-namespace:ControllerWheel"
        Title="{loc:T Configure OBS Integration}" Width="520" SizeToContent="Height"
        MinWidth="440" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource UiWindowBg}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SetupDialogTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <StackPanel Margin="22,18,22,16">
    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#3D405B"
               Text="{loc:T Configure OBS Integration}"/>
    <TextBlock Style="{StaticResource StepText}" Margin="0,10,0,0"
               Text="{loc:T 'OBS slices (streaming, recording, replay, scenes, source mute) talk to OBS over its local WebSocket server. One connection is shared by every OBS slice.'}"/>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Style="{StaticResource StepNum}" Text="1."/>
      <TextBlock Grid.Column="1" Style="{StaticResource StepText}"
                 Text="{loc:T In OBS: Tools → WebSocket Server Settings → enable the server.}"/>
    </Grid>
    <Grid Margin="0,5,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Style="{StaticResource StepNum}" Text="2."/>
      <TextBlock Grid.Column="1" Style="{StaticResource StepText}"
                 Text="{loc:T Copy its port (default 4455) and password into the fields below.}"/>
    </Grid>

    <Border Margin="0,12,0,0" CornerRadius="4" BorderThickness="1" BorderBrush="#22000000" ClipToBounds="True">
      <Image Source="pack://application:,,,/Assets/obs-setup.png" Stretch="Uniform"
             AutomationProperties.Name="{loc:T OBS Tools menu and WebSocket Server Settings dialog}"/>
    </Border>

    <TextBlock Text="{loc:T Port}" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,0"/>
    <TextBox x:Name="PortBox" Margin="0,2,0,0" Width="90" HorizontalAlignment="Left" FontSize="13"
             Padding="4,4" AutomationProperties.Name="{loc:T OBS port}" TextChanged="Field_Changed"/>
    <TextBlock Text="{loc:T Password}" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>
    <PasswordBox x:Name="PasswordField" Margin="0,2,0,0" Width="240" HorizontalAlignment="Left" FontSize="13"
                 Padding="4,4" AutomationProperties.Name="{loc:T OBS password}" PasswordChanged="Secret_Changed"/>
    <!-- The stored secret is never shown, so say it's there rather than faking dots in the box. -->
    <TextBlock x:Name="PasswordHint" Text="{loc:T (password saved — type here to replace it)}" Margin="0,3,0,0"
               Opacity="0.65" FontSize="11.5" Visibility="Collapsed"/>

    <TextBlock x:Name="StatusText" Margin="0,10,0,0" FontSize="12" Foreground="#88000000"
               TextWrapping="Wrap" MinHeight="16"/>

    <!-- One action button, as in the Discord pane: it reads "Test" until the connection checks out, then
         becomes "Save" (editing a field reverts it to "Test"). -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{loc:T Cancel}" Width="88" Padding="0,6" IsCancel="True" Margin="0,0,8,0"/>
      <Button x:Name="ActionBtn" Content="{loc:T Test}" Width="88" Padding="0,6" FontWeight="SemiBold" Click="ActionBtn_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
