<Window x:Class="ControllerWheel.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ControllerWheel"
        Title="{loc:T Pick Icon}" Width="620" Height="600" MinWidth="360" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource UiWindowBg}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SettingsTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- One glyph tile. White on the window tone like the Customize tiles; the current glyph carries
           their selection ring (TileSel in CustomizeEditorControl). -->
      <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Background"       Value="White"/>
        <Setter Property="BorderBrush"      Value="{StaticResource UiCardBorder}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Foreground"       Value="{StaticResource UiBodyInk}"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccessFocusVisual}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="8" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource UiHoverBg}"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource UiBorderHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource UiPressedBg}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                  <Setter TargetName="Bd" Property="BorderBrush" Value="#1CA8C9"/>
                  <Setter TargetName="Bd" Property="BorderThickness" Value="3"/>
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="12,12,12,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <TextBox x:Name="SearchBox" Padding="6,5" FontSize="13"
               BorderBrush="{StaticResource UiBorder}" Foreground="{StaticResource UiBodyInk}"
               AutomationProperties.Name="{loc:T Search icons…}"
               TextChanged="SearchBox_TextChanged"/>
      <TextBlock Text="{loc:T Search icons…}" IsHitTestVisible="False"
                 VerticalAlignment="Center" Margin="9,0,0,0"
                 Foreground="{StaticResource UiGhostInk}" FontSize="13">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                 Foreground="{StaticResource UiGhostInk}" IsHitTestVisible="False"
                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
    </Grid>

    <TextBlock x:Name="MatchCount" Grid.Row="1" Margin="2,6,0,6" FontSize="11.5"
               Foreground="{StaticResource UiMutedInk}"/>

    <!-- The full catalog is several thousand glyphs, so the grid is ROWS in a virtualizing list rather
         than one WrapPanel: only the rows on screen are built. IconPickerWindow.RebuildRows chunks the
         names to the width. -->
    <ItemsControl x:Name="IconRows" Grid.Row="2" Focusable="False"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                  SizeChanged="IconRows_SizeChanged">
      <ItemsControl.Template>
        <ControlTemplate TargetType="ItemsControl">
          <ScrollViewer x:Name="Scroller" Focusable="False" CanContentScroll="True"
                        VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <ItemsPresenter/>
          </ScrollViewer>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ItemsControl ItemsSource="{Binding}" Focusable="False" Height="{x:Static loc:IconPickerWindow.RowHeight}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource IconBtn}" Width="76" Height="80" Margin="2"
                        Tag="{Binding Name}" ToolTip="{Binding Name}"
                        AutomationProperties.Name="{Binding Name}" Click="IconButton_Click">
                  <StackPanel Width="70">
                    <Image Source="{Binding Image}" Width="32" Height="32"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Name}" FontSize="9" TextWrapping="Wrap" MaxWidth="66"
                               MaxHeight="28" TextAlignment="Center" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <DockPanel Grid.Row="3" Margin="0,10,0,0">
      <Button Content="{loc:T Use Default Icon}" DockPanel.Dock="Left" Click="BtnClear_Click"/>
      <Button Content="{loc:T Cancel}" DockPanel.Dock="Right" HorizontalAlignment="Right" IsCancel="True"/>
    </DockPanel>
  </Grid>
</Window>
