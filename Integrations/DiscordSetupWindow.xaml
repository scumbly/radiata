<Window x:Class="ControllerWheel.DiscordSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ControllerWheel"
        xmlns:local="clr-namespace:ControllerWheel"
        Title="{loc:T Configure Discord Integration}" Width="520" SizeToContent="Height"
        MinWidth="440" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource UiWindowBg}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SetupDialogTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <StackPanel Margin="22,18,22,16">
    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#3D405B"
               Text="{loc:T Configure Discord Integration}"/>
    <TextBlock Style="{StaticResource StepText}" Margin="0,10,0,0"
               Text="{loc:T 'Joining and leaving voice channels requires generating Discord application credentials. Without this you can still Launch, Mute, and Deafen in Discord, but you can\'t quickly join/leave specific chats from Radiata.'}"/>

    <!-- Numbered how-to; step 1's "the Developer Portal" is the link (no separate button). -->
    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Style="{StaticResource StepNum}" Text="1."/>
      <TextBlock Grid.Column="1" Style="{StaticResource StepText}" loc:LocRich.Source="Open [the Developer Portal](https://discord.com/developers/applications) and create a New Application called *Radiata*."/>
    </Grid>
    <Grid Margin="0,5,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Style="{StaticResource StepNum}" Text="2."/>
      <TextBlock Grid.Column="1" Style="{StaticResource StepText}">
        <Run Text="{loc:T Open its OAuth2 settings. Add the redirect: http://localhost}"/><Run Text=" "/><Hyperlink Click="CopyRedirect_Click" TextDecorations="None" ToolTip="{loc:T Copy to clipboard}" AutomationProperties.Name="{loc:T Copy redirect URL}"><Run x:Name="CopyRedirectGlyph" Text="⧉" FontSize="13"/></Hyperlink>
      </TextBlock>
    </Grid>
    <Grid Margin="0,5,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Style="{StaticResource StepNum}" Text="3."/>
      <TextBlock Grid.Column="1" Style="{StaticResource StepText}"
                 Text="{loc:T Copy the Client ID and Client Secret into the fields below.}"/>
    </Grid>

    <Border Margin="0,12,0,0" CornerRadius="4" BorderThickness="1" BorderBrush="#22000000" ClipToBounds="True">
      <Image Source="pack://application:,,,/Assets/discord-preview.png" Stretch="Uniform"
             AutomationProperties.Name="{loc:T 'Discord Developer Portal OAuth2 page showing Client ID, Client Secret and the redirect field'}"/>
    </Border>

    <TextBlock Text="{loc:T Client ID}" FontWeight="SemiBold" FontSize="12" Margin="0,14,0,0"/>
    <TextBox x:Name="IdBox" Margin="0,2,0,0" FontSize="13" Padding="4,4" AutomationProperties.Name="{loc:T Client ID}" TextChanged="Field_Changed"/>
    <TextBlock Text="{loc:T Client Secret}" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>
    <PasswordBox x:Name="SecretBox" Margin="0,2,0,0" FontSize="13" Padding="4,4" AutomationProperties.Name="{loc:T Client secret}" PasswordChanged="Secret_Changed"/>

    <TextBlock x:Name="StatusText" Margin="0,10,0,0" FontSize="12" Foreground="#88000000"
               TextWrapping="Wrap" MinHeight="16"/>

    <!-- One action button: it reads "Test" until a successful check, then becomes "Save" (editing a
         field reverts it to "Test"). -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{loc:T Cancel}" Width="88" Padding="0,6" IsCancel="True" Margin="0,0,8,0"/>
      <Button x:Name="ActionBtn" Content="{loc:T Test}" Width="88" Padding="0,6" FontWeight="SemiBold" Click="ActionBtn_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
