<Window x:Class="ControllerWheel.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ControllerWheel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FlowDirection="LeftToRight">
  <!-- FlowDirection is pinned left-to-right on this window: everything on it is drawn geometry keyed to
       the physical stick, never laid-out text. A right-to-left language shapes its text runs inside the
       drawing code; the window itself must never mirror (RadialMenuControl's ctor says why). -->
  <Canvas x:Name="RootCanvas">
    <!-- Full-screen dim behind the wheel while editing (sized in code; lowest z-order). -->
    <Rectangle x:Name="Scrim" Fill="#000010" Opacity="0" IsHitTestVisible="False"
               Canvas.Left="0" Canvas.Top="0"/>
    <local:RadialMenuControl x:Name="Menu"  Width="430" Height="430"/>
    <local:GameBrowserControl x:Name="Games" Visibility="Collapsed"/>
    <!-- Arcade: a round window sized + centred on the wheel it opened from (see OverlayWindow.ShowArcade).
         Code-drawn, no XAML resources — it paints every frame while it's up. -->
    <local:ArcadeControl x:Name="Arcade" Visibility="Collapsed"/>
  </Canvas>
</Window>
