<Window x:Class="ControllerWheel.SliceLogoPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radiata Picker — Slice Logos (dev)"
        Width="1020" Height="660" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterScreen" Background="#26262C">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Games (✓ = slice logo picked)" Foreground="#AAB" FontSize="12" Margin="2,0,0,6"/>
      <ListBox x:Name="GamesList" SelectionChanged="GamesList_SelectionChanged" FontSize="13"
               Background="#2E2E35" Foreground="#E8E8EE" BorderBrush="#44444C"/>
    </DockPanel>

    <DockPanel Grid.Column="1" Margin="12,0,0,0">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
        <TextBlock x:Name="HeaderText" Foreground="#F0F0F5" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusText" Foreground="#8FA88F" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"/>
        <Button DockPanel.Dock="Right" Content="Refresh Art" Padding="10,3" Click="Refresh_Click"
                ToolTip="Re-fetch logo candidates"/>
      </DockPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <WrapPanel x:Name="CandidatePanel"/>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
